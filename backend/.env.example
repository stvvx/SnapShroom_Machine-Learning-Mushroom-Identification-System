# ==================================================
# DATABASE CONFIGURATION
# ==================================================
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/snapshroom_db?retryWrites=true&w=majority&appName=Cluster0

# ==================================================
# SECURITY KEYS
# ==================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-here
SECRET_KEY=your-flask-secret-key-here

# ==================================================
# SERVER CONFIGURATION
# ==================================================
# Backend server host and port
HOST=0.0.0.0
PORT=5000
# Your local network IP address (CHANGE THIS to match your computer's IP)
BACKEND_IP=192.168.1.102

# ==================================================
# FRONTEND CONFIGURATION
# ==================================================
# Frontend port (for CORS)
FRONTEND_PORT=8081
# ngrok forwarding URL (UPDATE when ngrok URL changes)
NGROK_URL=https://your-ngrok-url.ngrok-free.dev

# ==================================================
# CUSTOM MODEL PATHS
# ==================================================
CUSTOM_MODEL_PATH=models/mushroom_classifier.pth
CUSTOM_CLASSES_PATH=models/mushroom_classes.json

# ==================================================
# CLOUDINARY CONFIGURATION
# ==================================================
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_API_KEY=your_api_key
EXPO_PUBLIC_CLOUDINARY_API_SECRET=your_api_secret

# ==================================================
# INSTRUCTIONS
# ==================================================
# 1. Copy this file as .env
# 2. Update BACKEND_IP with your computer's local IP address
# 3. Update NGROK_URL when you start ngrok (if using ngrok)
# 4. Fill in your actual database credentials
# 5. Set strong SECRET_KEY and JWT_SECRET_KEY values
# 6. Configure Cloudinary credentials
